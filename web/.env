# A placeholder so a local or CI build has something non-empty to compile
# against (createCoreStore refuses an empty baseUrl on purpose, and Vite's
# dead-code elimination will drop the whole app if the check above it can
# never be reached). The real deploy sets VITE_API_URL to the actual API
# host at build time; that wiring is a later task, not this one.
VITE_API_URL=https://api.example.com
