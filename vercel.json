{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/page.js": { "includeFiles": "site/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page" }
  ]
